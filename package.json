{
  "name": "@zeehdev/zeeh-kyc-react-sdk",
  "version": "1.2.1",
  "description": "Embeddable Zeeh KYC React widget: verification flows, face liveness, and typed API client.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepare": "npm run build",
    "dev": "vite -c vite.playground.config.ts",
    "build": "vite build && npx tsc -p tsconfig.emit.json && npx tsc-alias -p tsconfig.emit.json",
    "build:lib": "vite build",
    "lint": "eslint .",
    "preview": "vite preview -c vite.playground.config.ts"
  },

  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "framer-motion": "^12.0.0",
    "zustand": "^5.0.0",
    "zod": "^3.0.0",
    "axios": "^1.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.3.6",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "face-api.js": "^0.22.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.510.0",
    "naija-state-local-government": "^1.1.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^8.10.1",
    "react-hook-form": "^7.71.1",
    "react-phone-number-input": "^3.4.12",
    "react-qr-code": "^2.0.21",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.6",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "axios": "^1.9.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "framer-motion": "^12.11.3",
    "globals": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.6",
    "tsc-alias": "^1.8.17",
    "tw-animate-css": "^1.2.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.4"
  },
  "repository": {
  "type": "git",
  "url": "git+https://github.com/ZeehAfrica/kyc-widget-sdk.git"
}
